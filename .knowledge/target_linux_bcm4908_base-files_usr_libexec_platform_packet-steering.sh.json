{"is_source_file": true, "format": "shell script", "description": "This file is a shell script configuring packet steering and receive packet steering (RPS) settings based on system CPU count and hardware offloading capabilities. It reads configuration options via 'uci', determines the number of CPUs, and sets RPS CPU masks for network interfaces accordingly.", "external_files": ["/proc/cpuinfo", "/sys/class/net/eth0/queues/rx-0/rps_cpus", "/sys/class/net/br-lan/queues/rx-0/rps_cpus"], "external_methods": ["uci", "grep", "echo"], "published": [], "classes": [], "methods": [], "calls": ["uci -q get network.@globals[0].packet_steering", "grep -c \"^processor.*:\" /proc/cpuinfo", "uci -q get firewall.@defaults[0].flow_offloading", "uci -q get firewall.@defaults[0].flow_offloading_hw", "echo $rps_eth0 > /sys/class/net/eth0/queues/rx-0/rps_cpus", "echo $rps_br_lan > /sys/class/net/br-lan/queues/rx-0/rps_cpus"], "search-terms": ["packet steering", "RPS configuration", "shell script network tuning", "OpenWRT packet steering", "hw offloading", "flow offloading", "cpu count"], "state": 2, "file_id": 837, "knowledge_revision": 2920, "git_revision": "f06bd5bdb8e131a566d0f0068835296112f69915", "hash": "8587872fcfdfc15c6e10b3a9b1473db6", "format-version": 4, "code-base-name": "openwrt-313709", "filename": "target/linux/bcm4908/base-files/usr/libexec/platform/packet-steering.sh", "revision_history": [{"2920": "f06bd5bdb8e131a566d0f0068835296112f69915"}]}