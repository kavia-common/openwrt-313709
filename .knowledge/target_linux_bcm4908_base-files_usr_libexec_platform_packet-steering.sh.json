{"is_source_file": true, "format": "shell script", "description": "This file is a shell script configuring packet steering settings based on system parameters such as CPU count and hardware offloading options. It retrieves system configuration via 'uci', determines the appropriate 'rps_cpus' values for network interfaces, and writes these settings to sysfs paths to optimize network packet processing.", "external_files": ["/proc/cpuinfo", "/sys/class/net/eth0/queues/rx-0/rps_cpus", "/sys/class/net/br-lan/queues/rx-0/rps_cpus"], "external_methods": ["uci", "grep", "echo", "[", "case", "esac"], "published": [], "classes": [], "methods": [], "calls": ["uci -q get network.@globals[0].packet_steering", "grep -c \"^processor.*:\" /proc/cpuinfo", "uci -q get firewall.@defaults[0].flow_offloading", "uci -q get firewall.@defaults[0].flow_offloading_hw", "echo $rps_eth0 > /sys/class/net/eth0/queues/rx-0/rps_cpus", "echo $rps_br_lan > /sys/class/net/br-lan/queues/rx-0/rps_cpus"], "search-terms": ["packet steering", "flow offloading", "rps_cpus", "sysfs", "network tuner", "bc4908"], "state": 2, "file_id": 1178, "knowledge_revision": 3271, "git_revision": "f06bd5bdb8e131a566d0f0068835296112f69915", "hash": "8587872fcfdfc15c6e10b3a9b1473db6", "format-version": 4, "code-base-name": "openwrt-313709", "filename": "target/linux/bcm4908/base-files/usr/libexec/platform/packet-steering.sh", "revision_history": [{"3271": "f06bd5bdb8e131a566d0f0068835296112f69915"}]}