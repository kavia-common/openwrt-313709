{"is_source_file": true, "format": "C", "description": "This file implements a Linux kernel driver for Realtek SerDes (Serializer/Deserializer) modules accessible via MDIO bus. It includes functions for initializing, reading, writing, and debugging various SerDes models such as RTL838x, RTL839x, RTL930x, and RTL931x, with specific configurations and register mappings. The code also provides debug filesystem entries to facilitate register dumps and diagnostics.", "external_files": ["<linux/debugfs.h>", "<linux/mfd/core.h>", "<linux/mfd/syscon.h>", "<linux/module.h>", "<linux/of.h>", "<linux/of_mdio.h>", "<linux/of_platform.h>", "<linux/phy.h>", "<linux/platform_device.h>", "<linux/regmap.h>"], "external_methods": ["devm_mdiobus_alloc_size", "syscon_node_to_regmap", "devm_of_mdiobus_register", "debugfs_create_dir", "devm_kzalloc", "debugfs_create_file", "seq_printf", "seq_puts", "regmap_read", "regmap_write", "regmap_read_poll_timeout"], "published": ["rtsds_probe", "rtsds_read", "rtsds_write"], "classes": [], "methods": [{"name": "bool rtsds_mmd_to_sds(struct rtsds_ctrl * ctrl,int addr,int devad,int mmd_regnum,int * sds_page,int * sds_regnum)", "description": "Converts MDIO address and register number to SerDes data structure, extracting page and register number from the MMD register address.", "scope": "", "scopeKind": ""}, {"name": "int rtsds_dbg_registers_show(struct seq_file * seqf,void * unused)", "description": "Displays a register dump for the SerDes module via debugfs.", "scope": "", "scopeKind": ""}, {"name": "int rtsds_debug_init(struct rtsds_ctrl * ctrl)", "description": "Initializes debugfs entries for SerDes register dump.", "scope": "", "scopeKind": ""}, {"name": "int rtsds_838x_reg_offset(int sds,int page,int regnum)", "description": "Calculates register offset for RTL838x model based on SerDes, page, and register number.", "scope": "", "scopeKind": ""}, {"name": "int rtsds_838x_read(struct rtsds_ctrl * ctrl,int sds,int page,int regnum)", "description"