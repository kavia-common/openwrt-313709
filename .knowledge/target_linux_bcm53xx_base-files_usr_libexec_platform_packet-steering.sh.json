{"is_source_file": true, "format": "shell script", "description": "This file is a shell script configuring network packet steering and flow offloading settings on an OpenWRT device based on UCI configuration parameters.", "external_files": ["uci"], "external_methods": ["uci -q get"], "published": [], "classes": [], "methods": [], "calls": ["uci -q get network.@globals[0].packet_steering", "uci -q get firewall.@defaults[0].flow_offloading", "uci -q get firewall.@defaults[0].flow_offloading_hw", "echo 0 > /sys/class/net/br-lan/queues/rx-0/rps_cpus", "echo 0 > /sys/class/net/eth0/queues/rx-0/rps_cpus", "echo 2 > /sys/class/net/eth0/queues/rx-0/rps_cpus", "echo 2 > /sys/class/net/br-lan/queues/rx-0/rps_cpus"], "search-terms": ["packet_steering", "flow_offloading", "flow_offloading_hw", "rps_cpus", "uci", "network.@globals", "firewall.@defaults", "sys/class/net", "packet-steering.sh"], "state": 2, "file_id": 417, "knowledge_revision": 2499, "git_revision": "56a93f98738acd029c88e50de07911101746e565", "hash": "c4654500c03184fdbd6aaacab6fb914e", "format-version": 4, "code-base-name": "openwrt-313709", "filename": "target/linux/bcm53xx/base-files/usr/libexec/platform/packet-steering.sh", "revision_history": [{"2499": "56a93f98738acd029c88e50de07911101746e565"}]}