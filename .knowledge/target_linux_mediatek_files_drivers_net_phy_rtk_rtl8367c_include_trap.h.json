{"is_source_file": true, "format": "C header file", "description": "This file provides high-level API definitions for the trap module of RTL8367/RTL8367C switch hardware. It includes enumerations for trap types, multicast types, actions, reasons, and function prototypes for configuring trap behaviors, such as packet actions, trap priorities, LLDP settings, and RMA (Reserved Multicast Address) related configurations.", "external_files": ["https://www.gnu.org/licenses/old-licenses/gpl-2.0.txt"], "external_methods": [], "published": ["rtk_trap_unknownUnicastPktAction_set", "rtk_trap_unknownUnicastPktAction_get", "rtk_trap_unknownMacPktAction_set", "rtk_trap_unknownMacPktAction_get", "rtk_trap_unmatchMacPktAction_set", "rtk_trap_unmatchMacPktAction_get", "rtk_trap_unmatchMacMoving_set", "rtk_trap_unmatchMacMoving_get", "rtk_trap_unknownMcastPktAction_set", "rtk_trap_unknownMcastPktAction_get", "rtk_trap_lldpEnable_set", "rtk_trap_lldpEnable_get", "rtk_trap_reasonTrapToCpuPriority_set", "rtk_trap_reasonTrapToCpuPriority_get", "rtk_trap_rmaAction_set", "rtk_trap_rmaAction_get", "rtk_trap_rmaKeepFormat_set", "rtk_trap_rmaKeepFormat_get"], "classes": [], "methods": [{"name": "rtk_trap_unknownUnicastPktAction_set", "description": "Sets the action to be taken for unknown unicast packets received on a specific port."}, {"name": "rtk_trap_unknownUnicastPktAction_get", "description": "Retrieves the configured action for unknown unicast packets on a specific port."}, {"name": "rtk_trap_unknownMacPktAction_set", "description": "Sets the action for packets with unknown source MAC address."}, {"name": "rtk_trap_unknownMacPktAction_get", "description": "Gets the current action for packets with unknown source MAC address."}, {"name": "rtk_trap_unmatchMacPktAction_set", "description": "Sets the action for packets with unmatched MAC addresses."}, {"name": "rtk_trap_unmatchMacPktAction_get", "description": "Gets the current action for unmatched MAC address packets."}, {"name": "rtk_trap_unmatchMacMoving_set", "description": "Configures whether the source address in MAC packets can move (SA moving detection)."}, {"name": "rtk_trap_unmatchMacMoving_get", "description": "Retrieves whether SA moving is enabled for a port."}, {"name": "rtk_trap_unknownMcastPktAction_set", "description": "Sets the action for unknown multicast packets of a specific type on a port."}, {"name": "rtk_trap_unknownMcastPktAction_get", "description": "Gets the current action for unknown multicast packets of a specific type on a port."}, {"name": "rtk_trap_lldpEnable_set", "description": "Enables or disables LLDP processing on the switch."}, {"name": "rtk_trap_lldpEnable_get", "description": "Retrieves LLDP enable status."}, {"name": "rtk_trap_reasonTrapToCpuPriority_set", "description": "Sets the internal priority for packets trapped to CPU due to a specific reason."}, {"name": "rtk_trap_reasonTrapToCpuPriority_get", "description": "Gets the internal priority configured for specific trap reasons."}, {"name": "rtk_trap_rmaAction_set", "description": "Configures the action for Reserved Multicast Address (RMA) frames of a certain type."}, {"name": "rtk_trap_rmaAction_get", "description": "Retrieves the action configuration for RMA frames of a specific type."}, {"name": "rtk_trap_rmaKeepFormat_set", "description": "Enables or disables keeping the format for RMA frames."}, {"name": "rtk_trap_rmaKeepFormat_get", "description": "Retrieves whether the keep format setting is enabled for RMA frames."}], "calls": ["rtk_trap_unknownUnicastPktAction_set", "rtk_trap_unknownUnicastPktAction_get", "rtk_trap_unknownMacPktAction_set", "rtk_trap_unknownMacPktAction_get", "rtk_trap_unmatchMacPktAction_set", "rtk_trap_unmatchMacPktAction_get", "rtk_trap_unmatchMacMoving_set", "rtk_trap_unmatchMacMoving_get", "rtk_trap_unknownMcastPktAction_set", "rtk_trap_unknownMcastPktAction_get", "rtk_trap_lldpEnable_set", "rtk_trap_lldpEnable_get", "rtk_trap_reasonTrapToCpuPriority_set", "rtk_trap_reasonTrapToC