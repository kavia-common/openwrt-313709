e": "ecc_read32", "description": "Reads a 32-bit value from a register in the ECC engine."}, {"name": "ecc_write32", "description": "Writes a 32-bit value to a register in the ECC engine."}, {"name": "oob_fdm_ptr", "description": "Returns a pointer within the OOB (Out-Of-Band) area for FDM data for a specific sector."}, {"name": "oob_ecc_ptr", "description": "Returns a pointer within the OOB area for ECC parity data for a specific sector."}, {"name": "page_data_ptr", "description": "Returns a pointer to the data buffer for a specific sector within a page."}, {"name": "mt7621_ecc_wait_idle", "description": "Waits until the ECC engine is idle, with timeout handling."}, {"name": "mt7621_ecc_decoder_wait_done", "description": "Waits for the ECC decoder for a specific sector to complete."}, {"name": "mt7621_ecc_encoder_op", "description": "Enables or disables the ECC encoder unit."}, {"name": "mt7621_ecc_decoder_op", "description": "Enables or disables the ECC decoder unit."}, {"name": "mt7621_ecc_correct_check", "description": "Performs error correction on a sector, returning the number of corrected bits or error status."}, {"name": "mt7621_nfc_wait_write_completion", "description": "Waits for a write operation to complete, with timeout."}, {"name": "mt7621_nfc_hw_reset", "description": "Performs hardware reset of the NFI core, resetting registers and master interface."}, {"name": "mt7621_nfc_hw_init", "description": "Initializes hardware settings, reset, and default timing parameters."}, {"name": "mt7621_nfc_send_command", "description": "Sends a command to the NAND controller."}, {"name": "mt7621_nfc_send_address_byte", "description": "Sends a single address byte to the NAND controller."}, {"name": "mt7621_nfc_send_address", "description": "Sends multi-byte address for NAND operation."}, {"name": "mt7621_nfc_wait_pio_ready", "description": "Waits until the PIO (Programmed Input/Output) interface is ready for data transfer."}, {"name": "mt7621_nfc_pio_read", "descripti