{"is_source_file": true, "format": "Shell script", "description": "This file is a shell script that determines the presence and configuration flags for the ncurses library on the system. It attempts to find ncurses using pkg-config, checks standard include paths, and finally checks if the compiler can include ncurses header files. It outputs compiler flags and library linking flags or prints error messages if ncurses is not found.", "external_files": ["/usr/include/ncursesw/ncurses.h", "/usr/include/ncurses.h"], "external_methods": ["command -v", "${HOSTPKG_CONFIG} --exists", "${HOSTPKG_CONFIG} --cflags", "${HOSTPKG_CONFIG} --libs", "echo '#include <ncurses.h>' | ${HOSTCC} -E - >/dev/null 2>&1"], "published": [], "classes": [], "methods": [], "calls": ["command -v ${HOSTPKG_CONFIG}", "${HOSTPKG_CONFIG} --exists $PKG", "${HOSTPKG_CONFIG} --cflags ${PKG}", "${HOSTPKG_CONFIG} --libs ${PKG}", "${HOSTPKG_CONFIG} --exists ${PKG2}", "${HOSTPKG_CONFIG} --cflags ${PKG2}", "${HOSTPKG_CONFIG} --libs ${PKG2}", "echo '#include <ncurses.h>' | ${HOSTCC} -E - >/dev/null 2>&1"], "search-terms": ["ncurses", "pkg-config", "ncursesw", "shell script", "configure script", "libncurses"], "state": 2, "file_id": 457, "knowledge_revision": 2540, "git_revision": "65a3eb28d5ec276c960e992fc99d0d042f5c863f", "hash": "3d6aad4d063e75e466bd000e7d027aee", "format-version": 4, "code-base-name": "openwrt-313709", "filename": "scripts/config/mconf-cfg.sh", "revision_history": [{"2540": "65a3eb28d5ec276c960e992fc99d0d042f5c863f"}]}