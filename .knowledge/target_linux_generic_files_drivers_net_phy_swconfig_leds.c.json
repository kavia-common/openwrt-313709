{"is_source_file": true, "format": "C", "description": "This file provides LED trigger support for switch configuration API in a Linux kernel driver, specifically for managing switch port LEDs (link, traffic, speed) via sysfs entries and GPIO control. It defines data structures, sysfs attribute handlers, and functions to activate/deactivate LED triggers based on switch port states.", "external_files": ["<linux/leds.h>", "<linux/ctype.h>", "<linux/device.h>", "<linux/workqueue.h>"], "external_methods": ["led_set_brightness", "device_create_file", "device_remove_file", "schedule_delayed_work", "cancel_delayed_work_sync", "list_entry", "list_for_each"], "published": ["swconfig_trig_create_led_trigger", "swconfig_trig_destroy_led_trigger"], "classes": [{"name": "switch_led_trigger", "description": "Represents the LED trigger associated with a switch device, managing port link status, port traffic, speeds, and associated delayed work for updating LED status."}, {"name": "swconfig_trig_data", "description": "Holds per-LED configuration data including trigger settings, port masks, traffic counters, speed masks, and mode flags used for LED behavior control."}], "methods": [{"name": "void swconfig_trig_set_brightness(struct swconfig_trig_data * trig_data,enum led_brightness brightness)", "description": "Sets the brightness of an LED and updates the previous brightness state.", "scope": "", "scopeKind": ""}, {"name": "void swconfig_trig_update_port_mask(struct led_trigger * trigger)", "description": "Updates the combined port mask for all LEDs and schedules or cancels the LED update work accordingly.", "scope": "", "scopeKind": ""}, {"name": "ssize_t swconfig_trig_port_mask_store(struct device * dev,struct device_attribute * attr,const char * buf,size_t size)", "description": "Stores a new port mask value from sysfs input, updates the LED trigger configuration.", "scope": "", "scopeKind": ""}, {"name": "ssize_t swconfig_trig_port_mask_show(struct device * dev,struct device_at